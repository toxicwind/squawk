# estate-rebrand.pairs — retire the "sovereign" brand; "estate" is canonical.
#
# Engine: /home/toxic/estate/grasp-hub/skills/00_inbox/rename-roundup/rename.ts
#
#   bun run /home/toxic/estate/grasp-hub/skills/00_inbox/rename-roundup/rename.ts \
#     --repo /home/toxic/estate/ranch/squawk \
#     --pairs /home/toxic/estate/ranch/squawk/docs/estate-rebrand.pairs --dry-run
#
# Match modes:
#   substr  plain substring  (distinctive tokens: sovereign-chat, SOVEREIGN_CHAT)
#   word    whole word, \bOLD\b ("sovereign" alone — never "sovereign_chat")
#
# Every substr/word rule auto-expands to UPPER and Capitalized variants.
# Rules apply in file order, so the SPECIFIC rules come first and the generic
# `word: sovereign` rule comes last (it would otherwise eat the specific
# tokens first and produce "estate estate" / "estate-projects" artifacts).
#
# `exclude:` tokens are placeholder-armored before any rule runs, so they can
# never be rewritten.
#
# NOTE: this file is self-referential — it lives in the repo it rewrites. The
# `exclude:` lines that repeat each rule body keep those rule bodies intact if
# the engine is ever run again over this repo (the prose around them may still
# be re-branded; restore with `git checkout -- docs/estate-rebrand.pairs`).

# --- canonical brand form ---------------------------------------------------
substr: sovereign-chat => estate-chat
substr: SOVEREIGN_CHAT => ESTATE_CHAT
substr: SOVEREIGN_ROOT => ESTATE_ROOT

# --- specific brand phrases (must precede the generic word rule) -----------
# "the sovereign estate" -> "the estate"   (avoids "the estate estate")
substr: sovereign estate => estate
# upstream repo toxicwind/sovereign-projects -> toxicwind/estate. A blind
# "sovereign => estate" yields the non-existent toxicwind/estate-projects
# (HTTP 404); the canonical monorepo is toxicwind/estate. This also fixes the
# raw KB path (sovereign-projects/main/docs/fleet-knowledgebase.md).
substr: sovereign-projects => estate
# shields.io badge label -> the canonical estate-monorepo badge
# (same form as estate-chat/README.md).
substr: sovereign--projects => estate-monorepo

# --- mixed-case identifiers -----------------------------------------------
# \bword\b does NOT match "sovereign_ROUTER_URL" (underscore is a word char),
# so the generic word rule would silently skip it. The corral CLI
# (ranch/corral/src/cli/env.ts) reads ESTATE_ROUTER_URL, so the squawk bidder
# must export exactly that name.
substr: sovereign_ROUTER_URL => ESTATE_ROUTER_URL
substr: SOVEREIGN_ROUTER_URL => ESTATE_ROUTER_URL

# --- generic fallback -------------------------------------------------------
word: sovereign => estate

# --- PROTOCOL VALUES — never rewritten -------------------------------------
# squawk wire identifiers, channel names, sender identities and runner
# profiles are live protocol values, not branding. None of them contain
# "sovereign", so the rules above cannot reach them; these excludes make that
# guarantee explicit and survive a future edit to this file.
exclude: fleet
exclude: kappa_board
exclude: ops
exclude: leads
exclude: estate-chat
exclude: presence
exclude: bid-market
exclude: osprey
exclude: cinder
exclude: sable
exclude: marten
exclude: remora

# --- self-protection: keep this rule set intact on a re-run ----------------
exclude: sovereign-chat => estate-chat
exclude: SOVEREIGN_CHAT => ESTATE_CHAT
exclude: SOVEREIGN_ROOT => ESTATE_ROOT
exclude: sovereign estate => estate
exclude: sovereign-projects => estate
exclude: sovereign--projects => estate-monorepo
exclude: sovereign_ROUTER_URL => ESTATE_ROUTER_URL
exclude: SOVEREIGN_ROUTER_URL => ESTATE_ROUTER_URL
exclude: word: sovereign => estate
